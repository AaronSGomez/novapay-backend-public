# Database
DB_NAME=novapay_db
DB_USER=novapay_user
DB_PASSWORD=change_this_db_password

# JWT
JWT_SECRET=change_this_jwt_secret_long_random
JWT_EXPIRATION_MIN=60

# Digital signature
CERT_SIGNING_ENABLED=true
CERT_ALIAS=replace_with_real_alias
CERT_PASSWORD=replace_with_p12_password
CERT_P12_BASE64=replace_with_p12_base64

# VERIFACTU
VERIFACTU_ENDPOINT_URL=https://prewww1.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
VERIFACTU_SOAP_ACTION=RegFactuSistemaFacturacion
VERIFACTU_TIMEOUT=30s
VERIFACTU_MAX_RETRIES=3
VERIFACTU_PRODUCTION=false

# Optional chain seed (only if required for migrated chain start)
FISCAL_CHAIN_SEED_HASH=
