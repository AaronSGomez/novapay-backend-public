# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO DE EJEMPLO (.env.example)
# Copie este archivo como .env para su desarrollo local.
# NO suba su archivo .env real con credenciales a ningún repositorio.
# ==============================================================================

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=novapay_db
DB_USER=novapay_user
DB_PASSWORD=novapay_pass

# Seguridad JWT
JWT_SECRET=dGhpc2lzYWZha2VzZWNyZXRrZXlmb3JkZXZlbG9wbWVudG9ubHkxMjM0NTY3ODkw
JWT_EXPIRATION_MIN=60

# Certificado Digital PKCS#12 (Pruebas / Verifactu)
CERT_P12_BASE64=
CERT_PASSWORD=changeit
CERT_ALIAS=test-alias
CERT_SIGNING_ENABLED=false

# Verifactu AEAT
VERIFACTU_ENDPOINT_URL=https://prewww1.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
VERIFACTU_SOAP_ACTION=RegFactuSistemaFacturacion
VERIFACTU_TIMEOUT=30s
VERIFACTU_MAX_RETRIES=3
VERIFACTU_PRODUCTION=false
